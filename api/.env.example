# Copy to api/.env for local overrides. Every setting is optional; see app/config.py.
VYRO_ENV=local
VYRO_DATABASE_URL=postgresql+psycopg://vyro:vyro@localhost:5432/vyro

# dev accepts "dev:<uid>" bearer tokens (local only); firebase verifies real ID tokens.
VYRO_AUTH_MODE=dev
# VYRO_FIREBASE_PROJECT_ID=vyro-app-2026

# Unset: proof photos are stored in api/.uploads and served by this API, so the proof flow
# works offline. Set it to use Cloud Storage (needs a service account that can sign URLs).
# VYRO_PROOF_BUCKET=vyro-app-2026-proofs

# Unset: no Gemini calls; AI drafts come from the built-in templates. To use Gemini locally,
# run `gcloud auth application-default login` once, then set the project.
# VYRO_AI_PROJECT=vyro-app-2026

# Copy to .env, then restart `npx expo start`.

# Which API the app talks to. Leave it unset to use the local API in Docker
# (`docker compose up -d` once from the repo root): the app finds it on port 8000 of the
# computer running Expo. Otherwise, uncomment one of:
#   the mock server (npx @stoplight/prism-cli mock -h 0.0.0.0 contract/openapi.json):
# EXPO_PUBLIC_API_URL=http://<your computer's LAN IP>:4010
#   the deployed API (needs Firebase sign-in, so also remove EXPO_PUBLIC_DEV_UID):
# EXPO_PUBLIC_API_URL=https://vyro-api-2aczsavhwq-ew.a.run.app

# Local API and mock server only: skip sign-in and send requests as "dev:<this id>".
# Give the local API data for it with: python scripts/seed.py --uid <this id>  (from api/)
EXPO_PUBLIC_DEV_UID=dev-user

# Firebase — copy values from Project Settings → Your apps → Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

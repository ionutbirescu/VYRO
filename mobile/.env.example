# Copy to .env, then restart `npx expo start`.

# On a phone running Expo Go, "localhost" is the phone itself. Use one of:
#   - your computer's LAN IP, with the API started as: uvicorn app.main:app --host 0.0.0.0
#   - the mock server: npx @stoplight/prism-cli mock -h 0.0.0.0 contract/openapi.json  (port 4010)
#   - the deployed API: https://vyro-api-2aczsavhwq-ew.a.run.app  (needs Firebase sign-in)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Local API and mock server only: requests are sent as "dev:<this id>".
# Remove this when Firebase sign-in is active.
EXPO_PUBLIC_DEV_UID=dev-user

# Firebase — copy values from Project Settings → Your apps → Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

    </mxCell>
    <mxCell id="s1_run" value="&lt;b&gt;Cloud Run&lt;/b&gt;&lt;br&gt;&lt;small&gt;⚠ 1 instance · cold starts&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#FFC107;fontSize=13;" vertex="1" parent="s1">
      <mxGeometry x="100" y="110" width="145" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="s1_sql" value="&lt;b&gt;Cloud SQL&lt;/b&gt;&lt;br&gt;&lt;small&gt;⚠ f1-micro&lt;br&gt;25 conns max&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#FFC107;fontSize=13;" vertex="1" parent="s1">
      <mxGeometry x="10" y="225" width="130" height="85" as="geometry"/>
    </mxCell>
    <mxCell id="s1_gcs" value="&lt;b&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;small&gt;Proof photos&lt;br&gt;⚠ no CDN&lt;/small&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontSize=13;" vertex="1" parent="s1">
      <mxGeometry x="165" y="225" width="175" height="85" as="geometry"/>
    </mxCell>
    <mxCell id="s1_vai" value="&lt;b&gt;Vertex AI&lt;/b&gt;&lt;br&gt;&lt;small&gt;⚠ sync · blocks response&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#FFC107;fontSize=13;" vertex="1" parent="s1">

      <mxGeometry x="10" y="385" width="155" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="s2_vai" value="&lt;b&gt;Vertex AI&lt;/b&gt;&lt;br&gt;&lt;small&gt;✓ now async&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=13;" vertex="1" parent="s2">

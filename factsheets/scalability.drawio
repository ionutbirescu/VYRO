    <mxCell id="s2" value="STATE 2 — Intermediate (1K–10K users)" style="swimlane;startSize=40;fillColor=#F0F7FF;strokeColor=#4285F4;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">

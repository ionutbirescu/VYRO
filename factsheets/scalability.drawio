    <mxCell id="title" value="VYRO — Scalability: 3 Architecture States" style="text;html=1;fontStyle=1;fontSize=20;align=center;" vertex="1" parent="1">
      <mxGeometry x="0" y="5" width="1165" height="35" as="geometry"/>
    </mxCell>
    <mxCell id="legend" value="Color guide:  Gray = unchanged  ·  Yellow ⚠ = bottleneck  ·  Green ✓ = new or upgraded vs previous state" style="text;html=1;fontSize=12;align=center;" vertex="1" parent="1">
      <mxGeometry x="5" y="745" width="1160" height="25" as="geometry"/>
    </mxCell>
    <mxCell id="s1" value="STATE 1 — Current (~100 users, prototype)" style="swimlane;startSize=40;fillColor=#FFF8F0;strokeColor=#FFA500;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">

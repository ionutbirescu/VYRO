    </mxCell>
    <mxCell id="s1_mob" value="&lt;b&gt;Mobile App&lt;/b&gt;&lt;br&gt;&lt;small&gt;React Native · Expo&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontSize=13;" vertex="1" parent="s1">

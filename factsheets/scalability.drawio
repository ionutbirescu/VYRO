    <mxCell id="s3_run" value="&lt;b&gt;Cloud Run — microservices&lt;/b&gt;&lt;br&gt;&lt;small&gt;✓✓ split: challenges · social · AI — scale independently&lt;/small&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;strokeColor=#28A745;fontSize=13;" vertex="1" parent="s3">
